QFrame#categoryDetailHeader {
    background: palette(window);
    border: none;
}

QPushButton#backButton {
    background: palette(button);
    color: palette(button-text);
    border: 1px solid palette(mid);
    border-radius: 5px;
    padding: 5px 12px;
    font-size: 12px;
}

QPushButton#backButton:hover {
    background: palette(midlight);
}

QLabel#detailTitle {
    color: palette(text);
    font-size: 18px;
    font-weight: 700;
}

QLabel#detailIcon {
    font-size: 24px;
    background: transparent;
}

QFrame#entryParent {
    background: palette(base);
    border: 1px solid palette(mid);
    border-radius: 8px;
}

QLabel#entryParentName {
    color: palette(text);
    font-size: 14px;
    font-weight: 700;
}

QLabel#entryParentIcon {
    font-size: 18px;
    background: transparent;
}

QFrame#entryParent QPushButton {
    background: palette(button);
    color: palette(button-text);
    border: 1px solid palette(mid);
    border-radius: 5px;
    padding: 4px 10px;
    font-size: 11px;
}

QFrame#entryParent QPushButton:hover {
    background: palette(midlight);
}

QFrame#entryParent QPushButton#parentReset {
    background: transparent;
    color: palette(text);
    border: none;
}

QFrame#entryParent QPushButton#parentReset:hover {
    background: rgba(255, 149, 0, 60);
    color: #ff9500;
}

QFrame#entryParent QPushButton#parentToggle {
    background: transparent;
    color: palette(text);
    border: none;
    font-size: 14px;
    padding: 2px 6px;
}

QFrame#entryParent QPushButton#parentToggle:hover {
    background: palette(midlight);
    border-radius: 4px;
}

QFrame#entryParent QTabWidget::pane {
    background: palette(window);
    border: 1px solid palette(mid);
    border-radius: 6px;
    margin-top: 0;
    top: -1px;
}

QFrame#entryParent QTabWidget::tab-bar {
    left: 8px;
}

QFrame#entryBodyContainer {
    background: palette(window);
    border: 1px solid palette(mid);
    border-radius: 6px;
}

QWidget#entryTabPage {
    background: palette(window);
    border-radius: 6px;
}

QFrame#entryParent QTabBar {
    qproperty-drawBase: 0;
}

QFrame#entryParent QTabBar::tab {
    background: palette(button);
    color: palette(text);
    padding: 6px 18px;
    margin: 0;
    margin-right: 3px;
    border: 1px solid palette(mid);
    border-bottom: none;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    font-size: 11px;
}

/* Selected tab matches the pane's palette(window) so its bottom edge merges
   into the body — bold text alone marks it as active. */
QFrame#entryParent QTabBar::tab:selected {
    background: palette(window);
    font-weight: 700;
}

QFrame#entryParent QTabBar::tab:hover:!selected {
    background: palette(midlight);
}

QFrame#leafRow {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
}

QFrame#leafRow:hover {
    background: palette(button);
    border-color: palette(mid);
}

QLabel#leafIcon {
    font-size: 14px;
    background: transparent;
}

QLabel#leafName {
    color: palette(text);
    font-size: 12px;
    background: transparent;
}

QLabel#leafDetail {
    color: palette(text);
    font-size: 11px;
    background: transparent;
}

QFrame#leafRow QPushButton {
    background: palette(button);
    color: palette(button-text);
    border: 1px solid palette(mid);
    border-radius: 4px;
    padding: 3px 8px;
    font-size: 11px;
}

QFrame#leafRow QPushButton:hover {
    background: palette(midlight);
}

